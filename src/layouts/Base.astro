---
import site from '../data/site.json';
import InstagramIcon from '../components/InstagramIcon.astro';
const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} | ${site.business_name}` : site.business_name;
const ig = `https://www.instagram.com/${site.instagram_handle}/`;
const path = Astro.url.pathname;
const nav = [
  ['/', 'Home'],
  ['/products/', 'Products'],
  ['/gallery/', 'Gallery'],
  ['/custom-orders/', 'Custom orders'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="/">{site.business_name}</a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="btn btn-primary btn-sm header-ig" href={ig} target="_blank" rel="noopener"><InstagramIcon size={18} /> <span>@{site.instagram_handle}</span></a>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <p class="logo">{site.business_name}</p>
        <p>{site.location}</p>
        {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      </div>
      <a class="btn btn-light" href={ig} target="_blank" rel="noopener"><InstagramIcon /> Follow @{site.instagram_handle}</a>
    </div>
    <p class="wrap small">&copy; {new Date().getFullYear()} {site.business_name}</p>
  </footer>
  <a class="ig-float" href={ig} target="_blank" rel="noopener" aria-label="Open our Instagram"><InstagramIcon size={26} /></a>
</body>
</html>
<style is:global>
  :root {
    --bg: #fffaf4; --surface: #ffffff; --ink: #2b2230; --muted: #6b6070;
    --brand: #d6336c; --brand-dark: #a61e4d; --accent: #fcc419; --line: #eee3d8;
    --ig: linear-gradient(45deg, #f09433, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888);
    --radius: 18px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Nunito Sans', system-ui, sans-serif; font-size: 17px; line-height: 1.6; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--brand-dark); }
  h1, h2, h3, .logo { font-family: 'Fraunces', Georgia, serif; line-height: 1.15; margin: 0 0 .5em; }
  h1 { font-size: clamp(2rem, 5vw, 3.4rem); }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); }
  .wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }
  section { padding: 64px 0; }
  .small { font-size: .85rem; color: var(--muted); }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 60ch; }
  .center { text-align: center; } .center .lead { margin-inline: auto; }

  .btn { display: inline-flex; align-items: center; gap: .5em; padding: .8em 1.4em; border-radius: 999px; font-weight: 700; text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgb(0 0 0 / .12); }
  .btn-primary { background: var(--ig); color: #fff; }
  .btn-outline { border: 2px solid var(--ink); color: var(--ink); }
  .btn-light { background: #fff; color: var(--ink); }
  .btn-sm { padding: .55em 1em; font-size: .9rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }

  .site-header { position: sticky; top: 0; z-index: 10; background: rgb(255 250 244 / .92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; gap: 24px; padding: 14px 0; flex-wrap: wrap; }
  .logo { font-size: 1.35rem; font-weight: 700; color: var(--ink); text-decoration: none; margin: 0; }
  .site-header nav { display: flex; gap: 18px; flex-wrap: wrap; margin-right: auto; }
  .site-header nav a { color: var(--ink); text-decoration: none; font-weight: 600; }
  .site-header nav a[aria-current='page'] { color: var(--brand); text-decoration: underline; text-underline-offset: 6px; }
  @media (max-width: 720px) {
    .header-inner { gap: 10px; }
    .site-header nav { order: 3; width: 100%; gap: 14px; font-size: .95rem; }
    .header-ig { margin-left: auto; }
    .header-ig span { display: none; }
  }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
  .card { background: var(--surface); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: transform .15s, box-shadow .15s; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgb(0 0 0 / .08); }
  .card img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .card-body { padding: 16px 18px 20px; }
  .card-body h3 { font-size: 1.2rem; margin-bottom: .2em; }
  .price { color: var(--brand-dark); font-weight: 700; }

  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
  .gallery-grid figure { margin: 0; border-radius: var(--radius); overflow: hidden; position: relative; background: #eee; }
  .gallery-grid img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .gallery-grid figcaption { position: absolute; inset: auto 0 0 0; padding: 24px 12px 10px; color: #fff; font-weight: 600; background: linear-gradient(transparent, rgb(0 0 0 / .6)); }

  .ig-band { background: var(--ig); color: #fff; border-radius: var(--radius); padding: 48px 32px; text-align: center; }
  .ig-band .lead { color: rgb(255 255 255 / .9); margin-inline: auto; }
  .ig-band .actions { justify-content: center; }

  .site-footer { background: var(--ink); color: #f4eef6; padding: 40px 0 88px; margin-top: 40px; }
  .site-footer a:not(.btn) { color: #fff; }
  .site-footer .logo { color: #fff; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-bottom: 16px; }
  .site-footer .small { color: #b9aebe; }

  .ig-float { position: fixed; right: 18px; bottom: 18px; width: 56px; height: 56px; border-radius: 50%; background: var(--ig); color: #fff; display: grid; place-items: center; box-shadow: 0 8px 20px rgb(0 0 0 / .25); z-index: 20; }
  .prose p { max-width: 65ch; }
</style>

---
import site from '../data/site';
import InstagramIcon from '../components/InstagramIcon.astro';
const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} | ${site.business_name}` : site.business_name;
const ig = `https://www.instagram.com/${site.instagram_handle}/`;
const dm = `https://ig.me/m/${site.instagram_handle}`;
const nav = [
  ['/#collections', 'Collections'],
  ['/#process', 'How it works'],
  ['/gallery/', 'Gallery'],
  ['/#contact', 'Contact'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(site.hero_image, Astro.site ?? Astro.url).href} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="logo" href="/">{site.business_name}</a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="icon-btn" href={ig} target="_blank" rel="noopener" aria-label={`Instagram @${site.instagram_handle}`}><InstagramIcon size={20} /></a>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="logo">{site.business_name}</p>
        <p>{site.tagline}</p>
      </div>
      <div>
        <h3>Find us</h3>
        <p>{site.area_served}</p>
        {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
      </div>
      <div>
        <h3>Order on Instagram</h3>
        <p><a class="btn btn-pink" href={dm} target="_blank" rel="noopener"><InstagramIcon size={18} /> Message @{site.instagram_handle}</a></p>
      </div>
    </div>
    <p class="wrap small">&copy; {new Date().getFullYear()} {site.business_name} · <a href="/links/">Links</a></p>
  </footer>
  <a class="mobile-bar" href={dm} target="_blank" rel="noopener"><InstagramIcon size={20} /> Message us on Instagram</a>
</body>
</html>
<style is:global>
  :root {
    --brown: #5d4037; --brown-deep: #4a332c; --pink: #d68c96; --pink-soft: #f2cdd2; --pink-wash: #fcf0f1;
    --cream: #f8f5f2; --white: #fff; --text: #4b4541; --muted: #857c76; --line: #ece4de;
    --radius: 14px; --shadow: 0 10px 30px rgb(93 64 55 / .10);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; }
  body { margin: 0; background: var(--white); color: var(--text); font-family: Inter, system-ui, sans-serif; font-size: 16px; line-height: 1.65; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--brown); }
  h1, h2, h3, .logo { font-family: 'Playfair Display', Georgia, serif; color: var(--brown); line-height: 1.15; margin: 0 0 .5em; font-weight: 700; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); }
  h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); }
  h3 { font-size: 1.3rem; }
  .wrap { width: min(1160px, 100% - 32px); margin-inline: auto; }
  section { padding: 88px 0; }
  .bg-cream { background: var(--cream); }
  .eyebrow { display: block; font-size: .8rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--pink); margin-bottom: 10px; font-family: Inter, sans-serif; }
  .section-title { text-align: center; max-width: 640px; margin: 0 auto 48px; }
  .section-title p { color: var(--muted); }
  .small { font-size: .85rem; color: var(--muted); }
  .lead { font-size: 1.1rem; color: var(--muted); max-width: 52ch; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .55em; padding: .85em 1.6em; border-radius: 10px; font-weight: 600; font-size: .95rem; text-decoration: none; border: 2px solid transparent; transition: transform .15s, box-shadow .15s, background .15s; }
  .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .btn-brown { background: var(--brown); color: #fff; }
  .btn-brown:hover { background: var(--brown-deep); }
  .btn-pink { background: var(--pink-soft); color: var(--brown); }
  .btn-outline { border-color: var(--line); color: var(--brown); background: #fff; }
  .btn-white { background: #fff; color: var(--brown); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .site-header { position: sticky; top: 0; z-index: 30; background: rgb(255 255 255 / .94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; gap: 28px; padding: 14px 0; }
  .logo { font-size: 1.4rem; text-decoration: none; margin: 0; }
  .site-header nav { display: flex; gap: 26px; margin-left: auto; }
  .site-header nav a { color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem; }
  .site-header nav a:hover { color: var(--pink); }
  .icon-btn { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--pink-soft); color: var(--brown); }
  @media (max-width: 760px) {
    .site-header nav { display: none; }
    .icon-btn { margin-left: auto; }
  }

  .site-footer { background: var(--brown); color: #eadfda; padding: 64px 0 28px; }
  .site-footer .logo, .site-footer h3 { color: #fff; }
  .site-footer h3 { font-size: 1.1rem; }
  .site-footer a:not(.btn) { color: #fff; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; margin-bottom: 32px; }
  .site-footer .small { color: #c9b8b1; border-top: 1px solid rgb(255 255 255 / .15); padding-top: 20px; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; gap: 24px; } .site-footer { padding-bottom: 96px; } }

  .mobile-bar { display: none; }
  @media (max-width: 760px) {
    .mobile-bar { display: flex; align-items: center; justify-content: center; gap: 10px; position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 40; padding: 15px; border-radius: 12px; background: var(--brown); color: #fff; font-weight: 600; text-decoration: none; box-shadow: 0 8px 24px rgb(0 0 0 / .25); }
  }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 24px; }
  .prose p { max-width: 65ch; }
</style>

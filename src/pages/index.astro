---
import Base from '../layouts/Base.astro';
import InstagramButton from '../components/InstagramButton.astro';
import InstagramIcon from '../components/InstagramIcon.astro';
import ProductCard from '../components/ProductCard.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import site from '../data/site';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const known = site.categories ?? [];
const extra = [...new Set(products.map((p) => p.data.category).filter((c) => c && !known.includes(c)))];
const groups = [...known, ...extra]
  .map((name) => ({ name, items: products.filter((p) => p.data.category === name) }))
  .filter((g) => g.items.length);
const uncategorised = products.filter((p) => !p.data.category);
if (uncategorised.length) groups.push({ name: 'More', items: uncategorised });
const dm = `https://ig.me/m/${site.instagram_handle}`;
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        {site.hero_badge && <span class="badge">✿ {site.hero_badge}</span>}
        <h1>{site.hero_line_1}<br /><span class="pink">{site.hero_line_2}</span></h1>
        <p class="lead">{site.hero_text}</p>
        <div class="actions">
          <InstagramButton label="Start a custom order" dm />
          <a class="btn btn-outline" href="#collections">View collections</a>
        </div>
      </div>
      <div class="hero-media">
        <img src={site.hero_image} alt="" width="800" height="800" />
        {site.hero_quote && <blockquote>“{site.hero_quote}”<span>— {site.business_name}</span></blockquote>}
      </div>
    </div>
  </section>

  <!-- Occasions strip -->
  {site.occasions?.length > 0 && (
    <div class="occasions" aria-label="Occasions we make for">
      <div class="wrap occasions-inner">
        <span class="occ-label">Made for</span>
        {site.occasions.map((o) => <span class="occ">{o}</span>)}
      </div>
    </div>
  )}

  <!-- Intro -->
  <section class="intro">
    <div class="wrap intro-inner">
      <span class="eyebrow">{site.intro_eyebrow}</span>
      <h2>{site.intro_heading}</h2>
      <p>{site.intro_text}</p>
    </div>
  </section>

  <!-- Process -->
  <section id="process" class="bg-cream">
    <div class="wrap">
      <div class="section-title">
        <span class="eyebrow">The process</span>
        <h2>How ordering works</h2>
      </div>
      <ol class="steps">
        {(site.process_steps ?? []).map((s, i) => (
          <li><span class="num">{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Collections -->
  <section id="collections">
    <div class="wrap">
      <div class="section-title">
        <span class="eyebrow">Collections</span>
        <h2>What we make</h2>
        <p>Everything can be personalised. Prices are a guide, so message us for a quote. Quote the product code in your DM.</p>
      </div>
      {groups.map((g) => (
        <div class="category">
          <h3 class="cat-title">{g.name}</h3>
          <div class="card-grid">{g.items.map((p) => <ProductCard product={p} />)}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Instagram strip -->
  <InstagramFeed />

  <!-- Group orders + reviews -->
  <section class="group">
    <div class="wrap">
      <div class="group-cta">
        <div>
          <h2>{site.group_heading}</h2>
          <p>{site.group_text}</p>
        </div>
        <InstagramButton label="Ask about group orders" dm variant="white" />
      </div>
      {site.reviews?.length > 0 && (
        <div class="reviews">
          {site.reviews.map((r) => (
            <figure class="review">
              <div class="stars" aria-label="5 stars">★★★★★</div>
              <blockquote>“{r.quote}”</blockquote>
              <figcaption>{r.name}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Contact via Instagram -->
  <section id="contact" class="bg-cream">
    <div class="wrap contact">
      <div>
        <span class="eyebrow">Get in touch</span>
        <h2>{site.contact_heading}</h2>
        <p class="lead">{site.contact_text}</p>
        <a class="btn btn-brown big" href={dm} target="_blank" rel="noopener"><InstagramIcon size={22} /> Message us on Instagram</a>
      </div>
      <dl class="info">
        <div><dt>Current turnaround</dt><dd>{site.turnaround}</dd></div>
        <div><dt>Area served</dt><dd>{site.area_served}</dd></div>
        <div><dt>Instagram</dt><dd><a href={`https://www.instagram.com/${site.instagram_handle}/`} target="_blank" rel="noopener">@{site.instagram_handle}</a></dd></div>
        {site.email && <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>}
      </dl>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 72px 0 80px; background: linear-gradient(180deg, #fff 0%, var(--pink-wash) 100%); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .badge { display: inline-block; background: #fff; color: var(--brown); font-size: .8rem; font-weight: 600; padding: 6px 14px; border-radius: 999px; box-shadow: 0 2px 10px rgb(93 64 55 / .08); margin-bottom: 22px; }
  .pink { color: var(--pink); }
  .hero-media { position: relative; }
  .hero-media img { border-radius: 20px; aspect-ratio: 4 / 5; object-fit: cover; width: 100%; box-shadow: var(--shadow); }
  .hero-media blockquote { position: absolute; left: -36px; bottom: 28px; margin: 0; max-width: 260px; background: #fff; padding: 16px 18px; border-radius: 12px; box-shadow: var(--shadow); font-family: 'Playfair Display', serif; font-style: italic; color: var(--brown); font-size: 1rem; }
  .hero-media blockquote span { display: block; margin-top: 6px; font-family: Inter, sans-serif; font-style: normal; font-size: .75rem; color: var(--pink); }
  @media (max-width: 860px) {
    .hero { padding-top: 48px; }
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-media { max-width: 420px; }
    .hero-media blockquote { left: 12px; }
  }

  .occasions { background: var(--brown); color: #fff; padding: 18px 0; }
  .occasions-inner { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 28px; }
  .occ-label { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: var(--pink-soft); font-weight: 700; }
  .occ { font-family: 'Playfair Display', serif; font-size: 1.1rem; }
  .occ + .occ::before { content: '✿'; color: var(--pink); margin-right: 28px; font-size: .8rem; }
  @media (max-width: 600px) { .occ + .occ::before { margin-right: 10px; } .occasions-inner { gap: 6px 10px; } }

  .intro-inner { max-width: 720px; text-align: center; }
  .intro-inner p { font-size: 1.1rem; color: var(--muted); }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .steps li { background: #fff; border-radius: var(--radius); padding: 32px 28px; box-shadow: 0 2px 14px rgb(93 64 55 / .06); }
  .num { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--pink-soft); color: var(--brown); font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.3rem; margin-bottom: 16px; }
  .steps p { margin: 0; color: var(--muted); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }

  .category + .category { margin-top: 56px; }
  .cat-title { font-size: 1.6rem; display: flex; align-items: center; gap: 16px; margin-bottom: 22px; }
  .cat-title::after { content: ''; flex: 1; height: 1px; background: var(--line); }

  .group-cta { background: #6f5047; color: #f3e9e5; border-radius: 20px; padding: 48px; display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .group-cta h2 { color: #fff; margin-bottom: .3em; }
  .group-cta p { margin: 0; max-width: 56ch; }
  .reviews { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .review { margin: 0; background: var(--pink-wash); border-radius: var(--radius); padding: 28px; }
  .stars { color: var(--pink); letter-spacing: 2px; margin-bottom: 10px; }
  .review blockquote { margin: 0 0 14px; font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.08rem; color: var(--brown); }
  .review figcaption { font-size: .85rem; font-weight: 600; color: var(--muted); }
  @media (max-width: 860px) { .reviews { grid-template-columns: 1fr; } .group-cta { padding: 32px 24px; } }

  .contact { display: grid; grid-template-columns: 1.2fr .8fr; gap: 48px; align-items: center; }
  .big { font-size: 1.05rem; padding: 1em 1.8em; margin-top: 12px; }
  .info { margin: 0; background: #fff; border-radius: 20px; padding: 32px; box-shadow: var(--shadow); display: grid; gap: 20px; }
  .info dt { font-size: .75rem; letter-spacing: .15em; text-transform: uppercase; color: var(--pink); font-weight: 700; }
  .info dd { margin: 4px 0 0; font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--brown); }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>

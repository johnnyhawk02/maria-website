---
import Base from '../layouts/Base.astro';
import IgBand from '../components/IgBand.astro';
import gallery from '../data/gallery.json';
const items = gallery.items ?? [];
---
<Base title="Gallery">
  <section>
    <div class="wrap">
      <h1>Gallery</h1>
      <p class="lead">A few of our favourite orders. There's lots more on our Instagram.</p>
      <div class="gallery-grid" style="margin-top:32px">
        {items.map((g) => (
          <figure><img src={g.image} alt={g.caption ?? ''} loading="lazy" width="800" height="800" />{g.caption && <figcaption>{g.caption}</figcaption>}</figure>
        ))}
      </div>
    </div>
  </section>
  <IgBand />
</Base>

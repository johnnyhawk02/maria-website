---
import Base from '../layouts/Base.astro';
import IgBand from '../components/IgBand.astro';
import gallery from '../data/gallery.json';
const items = gallery.items ?? [];
---
<Base title="Gallery">
  <section>
    <div class="wrap">
      <span class="eyebrow">Portfolio</span>
      <h1>Gallery of our work</h1>
      <p class="lead">A few of our favourite orders. There's lots more on our Instagram.</p>
      <div class="gallery-grid" style="margin-top:32px">
        {items.map((g) => (
          <figure><img src={g.image} alt={g.caption ?? ''} loading="lazy" width="800" height="800" />{g.caption && <figcaption>{g.caption}</figcaption>}</figure>
        ))}
      </div>
    </div>
  </section>
  <IgBand />
</Base>
<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .gallery-grid figure { margin: 0; border-radius: var(--radius); overflow: hidden; position: relative; background: #eee; }
  .gallery-grid img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .gallery-grid figcaption { position: absolute; inset: auto 0 0 0; padding: 28px 14px 12px; color: #fff; font-weight: 600; background: linear-gradient(transparent, rgb(74 51 44 / .75)); }
</style>

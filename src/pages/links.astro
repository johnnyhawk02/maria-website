---
// Link-in-bio page: put https://<domain>/links in the Instagram bio.
import site from '../data/site';
const ig = `https://www.instagram.com/${site.instagram_handle}/`;
const links = [
  ['See what we make', '/products/'],
  ['Order something custom', '/custom-orders/'],
  ['See our gallery', '/gallery/'],
  ['Message us on Instagram', `https://ig.me/m/${site.instagram_handle}`],
];
if (site.email) links.push(['Email us', `mailto:${site.email}`]);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{site.business_name} | Links</title>
  <meta name="description" content={site.tagline} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <main>
    <img src={site.hero_image} alt="" width="120" height="120" />
    <h1>{site.business_name}</h1>
    <p>{site.tagline}</p>
    <ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
    <a class="handle" href={ig}>@{site.instagram_handle}</a>
  </main>
</body>
</html>
<style>
  body { margin: 0; min-height: 100vh; font-family: Inter, system-ui, sans-serif; color: #5d4037; background: linear-gradient(180deg, #fff, #fcf0f1); }
  main { max-width: 440px; margin: 0 auto; padding: 48px 16px; text-align: center; }
  img { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto 16px; display: block; border: 4px solid #fff; }
  h1 { font-family: 'Playfair Display', Georgia, serif; margin: 0 0 6px; }
  p { color: #857c76; margin: 0 0 28px; }
  ul { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 12px; }
  li a { display: block; padding: 16px; background: #fff; border-radius: 999px; color: #5d4037; font-weight: 700; text-decoration: none; box-shadow: 0 4px 14px rgb(0 0 0 / .06); }
  li a:hover { background: #5d4037; color: #fff; }
  .handle { color: #d68c96; font-weight: 700; }
</style>

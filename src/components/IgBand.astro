---
import site from '../data/site.json';
import InstagramButton from './InstagramButton.astro';
const { heading = 'See our latest makes on Instagram', text = 'We post new designs and customer orders every week. Follow along, or send us a message to order.' } = Astro.props;
---
<section>
  <div class="wrap">
    <div class="band">
      <h2>{heading}</h2>
      <p>{text}</p>
      <div class="actions">
        <InstagramButton label="Message us to order" dm variant="white" />
        <InstagramButton label={`Follow @${site.instagram_handle}`} variant="pink" />
      </div>
    </div>
  </div>
</section>
<style>
  .band { background: #6f5047; color: #f3e9e5; border-radius: 20px; padding: 48px 32px; text-align: center; }
  .band h2 { color: #fff; }
  .band p { max-width: 56ch; margin-inline: auto; }
  .band .actions { justify-content: center; }
</style>

---
import site from '../data/site.json';
const { product } = Astro.props;
const d = product.data;
const dm = `https://ig.me/m/${site.instagram_handle}`;
---
<article class="pcard">
  <a href={`/products/${product.id}/`} class="pcard-img"><img src={d.image} alt={d.title} loading="lazy" width="800" height="800" /></a>
  <div class="pcard-body">
    <h3><a href={`/products/${product.id}/`}>{d.title}</a></h3>
    <p class="pcard-meta">
      {d.price && <span class="price">{d.price}</span>}
      {d.code && <span class="code">{d.code}</span>}
    </p>
    <a class="pcard-dm" href={dm} target="_blank" rel="noopener">DM to order{d.code && <> · ask for {d.code}</>} &rarr;</a>
  </div>
</article>
<style>
  .pcard { background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: 0 2px 14px rgb(93 64 55 / .07); display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s; }
  .pcard:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .pcard-img img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .pcard-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .pcard h3 { font-size: 1.15rem; margin-bottom: 6px; }
  .pcard h3 a { color: inherit; text-decoration: none; }
  .pcard-meta { display: flex; justify-content: space-between; align-items: center; margin: 0 0 14px; }
  .price { font-weight: 600; color: var(--brown); }
  .code { font-size: .75rem; font-weight: 700; letter-spacing: .08em; color: var(--muted); background: var(--cream); padding: 3px 8px; border-radius: 6px; }
  .pcard-dm { margin-top: auto; font-size: .9rem; font-weight: 600; color: var(--pink); text-decoration: none; }
  .pcard-dm:hover { color: var(--brown); }
</style>
